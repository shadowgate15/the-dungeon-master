# Drizzle
DATABASE_URL=local.db

# AI (server-only). The model is unset by default, which means the AI is not configured.
# The recommended model is qwen3.5-9b, MLX 4-bit build (the Exchange eval's pick, see
# docs/research/exchange-model-eval.md). Every request sends temperature 0.7 and reasoning off.
# LM_STUDIO_MODEL=qwen/qwen3.5-9b
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Used for the context meter when LM Studio does not report the loaded context length (tokens).
# LM_STUDIO_CONTEXT_LIMIT=4096

# Dev-only "Report an issue" button. It files issues through the `gh` CLI (log in with `gh auth login`).
# REPORT_ISSUE_REPO=shadowgate15/the-dungeon-master
