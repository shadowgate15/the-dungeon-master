# Drizzle
DATABASE_URL=local.db

# Dev-only "Report an issue" button. It files issues through the `gh` CLI (log in with `gh auth login`).
# REPORT_ISSUE_REPO=shadowgate15/the-dungeon-master
# User-level state (Campaign registry). Default ~/.dungeon-master
# DUNGEON_MASTER_HOME=
# Where new Campaign folders are suggested. Default ~/dm-campaigns
# DUNGEON_MASTER_CAMPAIGNS=
