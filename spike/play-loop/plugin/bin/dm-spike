#!/usr/bin/env bash
# PROTOTYPE — launcher for the play-loop spike (#298).
# Run inside a campaign folder:  dm-spike [--auto-allow] [extra claude args]
#                                dm-spike stop
set -euo pipefail
PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SERVER="$PLUGIN_DIR/../server/server.ts"
RT="$HOME/.dm-spike/runtime.json"
mkdir -p "$HOME/.dm-spike"

rt() { node -e "console.log(JSON.parse(require('fs').readFileSync('$RT','utf8')).$1)" 2>/dev/null; }
healthy() { [ -f "$RT" ] && curl -sf -H "x-dm-token: $(rt token)" "http://127.0.0.1:$(rt port)/api/health" >/dev/null; }

if [ "${1:-}" = "stop" ]; then
  if healthy; then
    curl -sf -X POST -H "x-dm-token: $(rt token)" "http://127.0.0.1:$(rt port)/api/stop" >/dev/null || true
    echo "server stopped"
  else
    echo "server not running"
  fi
  exit 0
fi

AUTO=0
if [ "${1:-}" = "--auto-allow" ]; then AUTO=1; shift; fi

t0=$(date +%s)
if ! healthy; then
  echo "starting game server…"
  nohup node "$SERVER" >>"$HOME/.dm-spike/server.log" 2>&1 &
  for _ in $(seq 1 50); do healthy && break; sleep 0.1; done
  healthy || { echo "server failed to start; see ~/.dm-spike/server.log"; exit 1; }
fi
PORT=$(rt port); TOKEN=$(rt token)
curl -sf -X POST -H "x-dm-token: $TOKEN" -d "{\"path\":\"$PWD\"}" "http://127.0.0.1:$PORT/api/register" >/dev/null
URL="http://127.0.0.1:$PORT/?token=$TOKEN"
echo "server up in $(( $(date +%s) - t0 ))s · campaign: $PWD"
echo "UI: $URL"
if command -v open >/dev/null; then open "$URL"; fi

# The dev-channels flag only accepts an *installed* plugin (plugin:<name>@<marketplace>); a --plugin-dir
# plugin (@inline) is rejected as "plugin not installed". So install from the spike's local marketplace,
# at project scope: it lands in this campaign folder's .claude/settings.json, nothing global.
# A directory marketplace is read in place, so edits to the spike apply without reinstalling.
MARKET_DIR="$(cd "$PLUGIN_DIR/.." && pwd)"
if ! claude plugin list 2>/dev/null | grep -q 'dm-spike@dm-spike-local'; then
  echo "installing dm-spike@dm-spike-local into this folder (project scope)…"
  claude plugin marketplace add --scope project "$MARKET_DIR" >/dev/null
  claude plugin install --scope project dm-spike@dm-spike-local || { echo "plugin install failed"; exit 1; }
fi

export DM_SPIKE_CAMPAIGN="$PWD" DM_SPIKE_AUTOALLOW="$AUTO" MCP_PROTOCOL_NEGOTIATION=legacy
exec claude --dangerously-load-development-channels plugin:dm-spike@dm-spike-local "$@"
