  {
    "slug": "vampire-bat",
    "name": "Vampire, Bat Form",
    "size": "Medium",
    "type": "undead",
    "subtype": "shapechanger",
    "alignment": "lawful evil",
    "armorClass": [
      {
        "type": "natural",
